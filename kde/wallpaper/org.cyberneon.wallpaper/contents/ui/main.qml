// CyberNeon Live - animated wallpaper for Plasma 6 (X11 and Wayland). Original artwork.
// FAN MADE - inspired by Cyberpunk 2077 by CD PROJEKT RED (trademarks of CD PROJEKT S.A.).
//
// The static CyberNeon wallpaper (3840x2160, generated by make_wallpaper.py) plus animated layers placed in the
// wallpaper's own coordinates: scan line, rotating arcs around the sigil, blinking network nodes, data packets on
// the highlighted route, falling hex columns and short periodic glitches.
import QtQuick
import QtQuick.Shapes
import org.kde.plasma.plasmoid

WallpaperItem {
    id: root

    readonly property string imageUrl: root.configuration.Image || ""
    readonly property bool animated: root.configuration.Animated !== false

    // wallpaper image coordinates (3840x2160) -> item coordinates ("scaled and cropped")
    readonly property real sc: Math.max(width / 3840, height / 2160)
    readonly property real ox: (width - 3840 * sc) / 2
    readonly property real oy: (height - 2160 * sc) / 2
    function mx(x) { return ox + x * sc }
    function my(y) { return oy + y * sc }

    readonly property color cy: "#5beedc"
    readonly property color red: "#ff2a4f"

    Rectangle { anchors.fill: parent; color: "#070d1a" }

    Image {
        id: base
        anchors.fill: parent
        source: root.imageUrl
        fillMode: Image.PreserveAspectCrop
        asynchronous: true
        cache: false
        smooth: true
    }

    Item {
        id: fx
        anchors.fill: parent
        visible: root.animated && base.status === Image.Ready

        // ---------------------------------------------------------- falling hex columns
        Repeater {
            model: 9
            Text {
                id: col
                required property int index
                property real speed: 14000 + (index * 3779) % 9000
                x: root.width * ((index * 0.137 + 0.06) % 1)
                font.family: "JetBrainsMono Nerd Font Mono"
                font.pixelSize: Math.max(10, 24 * root.sc)
                color: root.cy
                opacity: 0.22
                lineHeight: 1.15
                text: ""
                function refresh() {
                    var s = "";
                    for (var i = 0; i < 18; i++) s += "0123456789ABCDEF"[Math.floor(Math.random() * 16)] + "\n";
                    text = s;
                }
                Component.onCompleted: refresh()
                Timer { interval: 180 + col.index * 23; running: fx.visible; repeat: true; onTriggered: col.refresh() }
                NumberAnimation on y {
                    running: fx.visible
                    from: -col.height; to: root.height
                    duration: col.speed
                    loops: Animation.Infinite
                }
            }
        }

        // ---------------------------------------------------------- rotating arcs around the sigil (1920, 1010)
        Item {
            x: root.mx(1920); y: root.my(1010)
            Shape {
                preferredRendererType: Shape.CurveRenderer
                RotationAnimation on rotation { running: fx.visible; from: 0; to: 360; duration: 48000; loops: Animation.Infinite }
                ShapePath {
                    strokeColor: Qt.rgba(1, 0.165, 0.31, 0.75); strokeWidth: Math.max(2, 7 * root.sc); fillColor: "transparent"
                    capStyle: ShapePath.FlatCap
                    PathAngleArc { radiusX: 600 * root.sc; radiusY: 600 * root.sc; startAngle: 0; sweepAngle: 34 }
                }
                ShapePath {
                    strokeColor: Qt.rgba(1, 0.165, 0.31, 0.75); strokeWidth: Math.max(2, 7 * root.sc); fillColor: "transparent"
                    capStyle: ShapePath.FlatCap
                    PathAngleArc { radiusX: 600 * root.sc; radiusY: 600 * root.sc; startAngle: 180; sweepAngle: 12 }
                }
            }
            Shape {
                preferredRendererType: Shape.CurveRenderer
                RotationAnimation on rotation { running: fx.visible; from: 360; to: 0; duration: 30000; loops: Animation.Infinite }
                ShapePath {
                    strokeColor: Qt.rgba(0.36, 0.93, 0.86, 0.55); strokeWidth: Math.max(1, 3 * root.sc); fillColor: "transparent"
                    strokeStyle: ShapePath.DashLine; dashPattern: [6, 5]
                    PathAngleArc { radiusX: 650 * root.sc; radiusY: 650 * root.sc; startAngle: 20; sweepAngle: 70 }
                }
                ShapePath {
                    strokeColor: Qt.rgba(0.36, 0.93, 0.86, 0.55); strokeWidth: Math.max(1, 3 * root.sc); fillColor: "transparent"
                    strokeStyle: ShapePath.DashLine; dashPattern: [6, 5]
                    PathAngleArc { radiusX: 650 * root.sc; radiusY: 650 * root.sc; startAngle: 200; sweepAngle: 45 }
                }
            }
        }

        // ---------------------------------------------------------- network: blinking nodes, pulsing target
        Repeater {
            model: [[2820, 330], [3080, 250], [3330, 380], [3560, 280], [2950, 560], [3220, 620], [3480, 560], [3100, 860]]
            Rectangle {
                id: node
                required property var modelData
                required property int index
                width: 40 * root.sc; height: width
                x: root.mx(modelData[0]) - width / 2; y: root.my(modelData[1]) - height / 2
                color: "transparent"; border.color: root.cy; border.width: Math.max(1, 4 * root.sc)
                opacity: 0
                SequentialAnimation on opacity {
                    running: fx.visible; loops: Animation.Infinite
                    PauseAnimation { duration: 900 + (node.index * 1373) % 4200 }
                    NumberAnimation { to: 0.95; duration: 120 }
                    NumberAnimation { to: 0; duration: 700; easing.type: Easing.OutQuad }
                }
            }
        }
        Rectangle {   // target (3650, 760)
            id: target
            property real s: 1
            width: 40 * root.sc * s; height: width
            x: root.mx(3650) - width / 2; y: root.my(760) - height / 2
            color: "transparent"; border.color: root.red; border.width: Math.max(1, 4 * root.sc)
            opacity: 1.6 - s * 0.55
            NumberAnimation on s { running: fx.visible; from: 1; to: 2.8; duration: 1600; loops: Animation.Infinite; easing.type: Easing.OutCubic }
        }

        // ---------------------------------------------------------- data packets on the route 0-4-5-6-7
        Repeater {
            model: 3
            Rectangle {
                id: packet
                required property int index
                width: Math.max(4, 14 * root.sc); height: width
                color: index === 1 ? root.red : root.cy
                PathAnimation {
                    target: packet
                    running: fx.visible
                    loops: Animation.Infinite
                    duration: 5200
                    anchorPoint: Qt.point(packet.width / 2, packet.height / 2)
                    Component.onCompleted: { if (packet.index > 0) start() }
                    path: Path {
                        startX: root.mx(2820); startY: root.my(330)
                        PathLine { x: root.mx(2950); y: root.my(560) }
                        PathLine { x: root.mx(3220); y: root.my(620) }
                        PathLine { x: root.mx(3480); y: root.my(560) }
                        PathLine { x: root.mx(3650); y: root.my(760) }
                    }
                }
                Timer {  // stagger the packets
                    interval: 1700 * packet.index; running: true; repeat: false
                    onTriggered: packet.visible = true
                }
                visible: index === 0
            }
        }

        // ---------------------------------------------------------- scan line with a soft trail
        Item {
            id: scan
            width: root.width; height: 90
            Rectangle {
                anchors.fill: parent
                gradient: Gradient {
                    GradientStop { position: 0.0; color: "transparent" }
                    GradientStop { position: 1.0; color: Qt.rgba(0.36, 0.93, 0.86, 0.07) }
                }
            }
            Rectangle { anchors.bottom: parent.bottom; width: parent.width; height: 2; color: root.cy; opacity: 0.22 }
            NumberAnimation on y { running: fx.visible; from: -90; to: root.height; duration: 11000; loops: Animation.Infinite }
        }

        // ---------------------------------------------------------- periodic glitch: displaced slices of the image
        Item {
            id: glitch
            anchors.fill: parent
            visible: false
            property int seed: 1
            function rnd(i, k) { var v = Math.sin(seed * 12.9898 + i * 78.233 + k * 37.719) * 43758.5453; return v - Math.floor(v) }
            Repeater {
                model: 5
                ShaderEffectSource {
                    required property int index
                    sourceItem: base
                    readonly property real sy: glitch.rnd(index, 1) * root.height
                    readonly property real sh: 4 + glitch.rnd(index, 2) * 26
                    sourceRect: Qt.rect(0, sy, root.width, sh)
                    x: (glitch.rnd(index, 3) - 0.5) * 120
                    y: sy
                    width: root.width; height: sh
                }
            }
            Rectangle {   // red/cyan split flash
                y: glitch.rnd(9, 4) * root.height; width: root.width; height: 3
                color: glitch.seed % 2 ? root.red : root.cy; opacity: 0.6
            }
        }
        Timer {
            id: glitchTimer
            interval: 9000; running: fx.visible; repeat: true
            onTriggered: {
                glitch.seed += 1; glitch.visible = true; glitchOff.restart();
                interval = 7000 + Math.floor(Math.random() * 7000);
            }
        }
        Timer { id: glitchOff; interval: 130; onTriggered: glitch.visible = false }
    }
}
